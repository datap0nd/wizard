    {
      "name": "wizard_read_attachment",
      "description": "Read a file the user attached to this conversation (PowerPoint, Excel, Word, email, CSV), converted to text: slides with their charts' values and notes, sheets with column profiles and formulas. Use the label listed in the request (F1, F2...). The first call lists the file's parts; read a part by name for long files. Each read is evidence (USER_PROVIDED) to cite like [E3].",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "file": {
            "description": "The attached file's label, e.g. 'F1' (listed in the request) (pattern ^F[0-9]{1,3}$)",
            "type": "string"
          },
          "part": {
            "description": "Only this part, e.g. 'Slide 4' or 'Sheet: Sales' (names come back in 'parts'). Omit to read from the start (0-120 characters)",
            "type": "string"
          },
          "offset": {
            "description": "Continue a long file from the next_offset you were given (default 0)",
            "maximum": 50000000,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wizard_calculate",
      "description": "Evaluate arithmetic exactly over named numbers (e.g. growth, ratios, per-million normalisation) instead of doing long arithmetic in your head.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "expression": {
            "description": "Arithmetic using + - * / ** % ( ) and abs, min, max, sum, avg, round, sqrt, e.g. '(q3 - q2) / spend_musd' (1-500 characters)",
            "type": "string"
          },
          "variables": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "(pattern ^[A-Za-z_][A-Za-z0-9_]{0,40}$)"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "type": "object"
            },
            "maxItems": 40,
            "type": "array"
          }
        },
        "required": [
          "expression"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wizard_render_visual",
      "description": "Show a chart or table in the answer. Provide the exact values, units and the evidence ids they come from; returns an id such as V1 to place in the answer.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "bar for ranking/comparison, line for time series, scatter for two measures, table for exact values.",
            "enum": [
              "bar",
              "line",
              "scatter",
              "table"
            ],
            "type": "string"
          },
          "title": {
            "type": "string",
            "description": "(1-120 characters)"
          },
          "subtitle": {
            "type": "string",
            "description": "(0-240 characters)"
          },
          "columns": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "description": "(pattern ^[A-Za-z0-9_]{1,40}$)"
                },
                "label": {
                  "type": "string",
                  "description": "(1-80 characters)"
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "percent",
                    "currency"
                  ],
                  "type": "string",
                  "description": "(default \"string\")"
                },
                "unit": {
                  "type": "string",
                  "description": "(0-16 characters)"
                }
              },
              "required": [
                "key",
                "label"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          },
          "rows": {
            "description": "One list per row, in column order. Numbers may be given as numbers or numeric text.",
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "x": {
            "description": "Column key for categories or time (charts).",
            "type": "string"
          },
          "series": {
            "description": "Numeric column keys to plot (charts).",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "evidence_ids": {
            "description": "Evidence ids the values come from, e.g. ['E1','E2'].",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "note": {
            "description": "How values were derived and any caveat (0-400 characters)",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title",
          "columns",
          "rows"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wizard_check_my_data",
      "description": "Optional verification. Recompute figures you state from the cited evidence rows, check that each figure covers the period you claim, and optionally re-run cited requests to detect changed source data. Reports MATCH, DISCREPANCY, PERIOD_MISMATCH or NOT_VERIFIABLE per figure; it never edits your answer.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "description": "Figures from your answer to recompute from cited evidence.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "description": "The statement being checked, e.g. 'EG Q3 spend' (1-160 characters)",
                  "type": "string"
                },
                "stated_value": {
                  "description": "The number as stated in the answer.",
                  "type": "number"
                },
                "evidence_id": {
                  "description": "For a direct figure: the evidence it comes from (pattern ^E[0-9]{1,4}$)",
                  "type": "string"
                },
                "measure": {
                  "type": "string",
                  "description": "(pattern ^[a-z][a-z0-9_]{0,63}$)"
                },
                "where": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "type": "string",
                        "description": "(pattern ^[a-z][a-z0-9_]{0,63}$)"
                      },
                      "values": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 50,
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "field",
                      "values"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "aggregate": {
                  "enum": [
                    "sum",
                    "value",
                    "mean",
                    "min",
                    "max",
                    "count"
                  ],
                  "type": "string",
                  "description": "(default \"sum\")"
                },
                "period": {
                  "type": "string",
                  "description": "(pattern ^[0-9]{4}-(Q[1-4]|[0-9]{2})$)"
                },
                "expression": {
                  "description": "For a derived figure: arithmetic over input names (0-300 characters)",
                  "type": "string"
                },
                "inputs": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
