    {
      "name": "wizard_render_visual",
      "description": "Show a chart or table in the answer. Provide the exact values, units and the evidence ids they come from; returns an id such as V1 to place in the answer.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "bar for ranking/comparison, line for time series, scatter for two measures, table for exact values.",
            "enum": [
              "bar",
              "line",
              "scatter",
              "table"
            ],
            "type": "string"
          },
          "subtitle": {
            "maxLength": 240,
            "type": "string"
          },
          "columns": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "key": {
                  "pattern": "^[A-Za-z0-9_]{1,40}$",
                  "type": "string"
                },
                "label": {
                  "maxLength": 80,
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "default": "string",
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "percent",
                    "currency"
                  ],
                  "type": "string"
                },
                "unit": {
                  "maxLength": 16,
                  "type": "string"
                }
              },
              "required": [
                "key",
                "label"
              ],
              "type": "object"
            },
            "maxItems": 12,
            "minItems": 1,
            "type": "array"
          },
          "rows": {
            "description": "One list per row, in column order. Numbers may be given as numbers or numeric text.",
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
          },
          "x": {
            "description": "Column key for categories or time (charts).",
            "type": "string"
          },
          "series": {
            "description": "Numeric column keys to plot (charts).",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "evidence_ids": {
            "description": "Evidence ids the values come from, e.g. ['E1','E2'].",
            "items": {
              "type": "string"
            },
            "maxItems": 20,
            "type": "array"
          },
          "note": {
            "description": "How values were derived and any caveat.",
            "maxLength": 400,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "title",
          "columns",
          "rows"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "wizard_check_my_data",
      "description": "Optional verification. Recompute figures you state from the cited evidence rows, check that each figure covers the period you claim, and optionally re-run cited requests to detect changed source data. Reports MATCH, DISCREPANCY, PERIOD_MISMATCH or NOT_VERIFIABLE per figure; it never edits your answer.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "claims": {
            "description": "Figures from your answer to recompute from cited evidence.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "description": "The statement being checked, e.g. 'EG Q3 spend'.",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "stated_value": {
                  "description": "The number as stated in the answer.",
                  "type": "number"
                },
                "evidence_id": {
                  "description": "For a direct figure: the evidence it comes from.",
                  "pattern": "^E[0-9]{1,4}$",
                  "type": "string"
                },
                "measure": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "where": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "field": {
                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                        "type": "string"
                      },
                      "values": {
                        "items": {
                          "type": "string"
                        },
                        "maxItems": 50,
                        "minItems": 1,
                        "type": "array"
                      }
                    },
                    "required": [
                      "field",
                      "values"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "aggregate": {
                  "default": "sum",
                  "enum": [
                    "sum",
                    "value",
                    "mean",
                    "min",
                    "max",
                    "count"
                  ],
                  "type": "string"
                },
                "period": {
                  "pattern": "^[0-9]{4}-(Q[1-4]|[0-9]{2})$",
                  "type": "string"
                },
                "expression": {
                  "description": "For a derived figure: arithmetic over input names.",
                  "maxLength": 300,
                  "type": "string"
                },
                "inputs": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,40}$",
                        "type": "string"
                      },
                      "evidence_id": {
                        "pattern": "^E[0-9]{1,4}$",
                        "type": "string"
                      },
                      "measure": {
                        "pattern": "^[a-z][a-z0-9_]{0,63}$",
                        "type": "string"
                      },
                      "where": {
                        "items": {
                          "additionalProperties": false,
                          "properties": {
                            "field": {
                              "pattern": "^[a-z][a-z0-9_]{0,63}$",
                              "type": "string"
                            },
                            "values": {
                              "items": {
                                "type": "string"
                              },
                              "maxItems": 50,
                              "minItems": 1,
                              "type": "array"
                            }
                          },
                          "required": [
                            "field",
                            "values"
                          ],
                          "type": "object"
                        },
                        "maxItems": 8,
                        "type": "array"
                      },
                      "aggregate": {
                        "default": "sum",
                        "enum": [
                          "sum",
                          "value",
                          "mean",
                          "min",
                          "max",
                          "count"
                        ],
                        "type": "string"
                      },
                      "period": {
                        "description": "Period this input should cover, e.g. 2026-Q3 or 2026-07.",
                        "pattern": "^[0-9]{4}-(Q[1-4]|[0-9]{2})$",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "evidence_id",
                      "measure"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "tolerance_pct": {
                  "default": 0.5,
                  "maximum": 10,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "label",
                "stated_value"
              ],
              "type": "object"
            },
            "maxItems": 30,
            "type": "array"
          },
          "replay_evidence_ids": {
            "description": "Evidence ids whose source request should be re-run to detect changed data.",
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "type": "array"
          }
        },
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
