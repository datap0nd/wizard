    {
      "name": "asap_run_report",
      "description": "Read rows from one ASAP report with prompt filters and optional grouping (read-only, at most 500 rows). Each call is recorded as evidence with an id such as E3: cite it as [E3] next to numbers that come from it. Missing rows mean no data, not zero.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "report_id": {
            "description": "Report id from a search result.",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$",
            "type": "string"
          },
          "filters": {
            "description": "Prompt answers: rows must match every filter.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "description": "A dimension key from the report schema, e.g. market, fiscal_quarter, month, model_code.",
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "values": {
                  "description": "Accepted values, e.g. ['SA','AE'] or ['2026-Q3'].",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 50,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "field",
                "values"
              ],
              "type": "object"
            },
            "maxItems": 10,
            "type": "array"
          },
          "group_by": {
            "description": "Optional dimensions to aggregate to. Omit to get rows at the report grain. Measures aggregate by their declared rule (sum, period-end balance, or not aggregatable).",
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "type": "array"
          },
          "measures": {
            "description": "Optional subset of measure keys; omit for all.",
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "type": "array"
          },
          "sort": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "field": {
                  "pattern": "^[a-z][a-z0-9_]{0,63}$",
                  "type": "string"
                },
                "direction": {
                  "default": "asc",
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "field"
              ],
              "type": "object"
            },
            "maxItems": 3,
            "type": "array"
          },
          "limit": {
            "default": 200,
            "description": "Maximum rows returned (hard cap 500).",
            "maximum": 500,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "report_id"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
