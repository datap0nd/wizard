{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wizard.internal/contracts/run-event.schema.json",
  "title": "Wizard run event",
  "description": "One observed event of an agent run, as stored and streamed (SSE data). Events record what actually happened; they never contain private chain of thought.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "type", "ts", "payload"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string"},
    "type": {"enum": ["run_started", "status", "agent_session", "text_delta", "note", "model_tool_trace", "tool_started",
                      "tool_finished", "visual_added", "check_result", "schedule_proposed", "access_request_proposed", "file_made",
                      "warning", "agent_stats", "model_wait", "diagnostic", "steer", "steer_read", "systems_changed",
                      "system_requested", "run_finished", "run_failed"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "tool_started"}}},
     "then": {"properties": {"payload": {"required": ["call_id", "name", "label", "category", "arguments"]}}}},
    {"if": {"properties": {"type": {"const": "tool_finished"}}},
     "then": {"properties": {"payload": {"required": ["call_id", "name", "ok", "duration_ms", "summary"]}}}},
    {"if": {"properties": {"type": {"const": "text_delta"}}},
     "then": {"properties": {"payload": {"required": ["text"]}}}},
    {"if": {"properties": {"type": {"const": "model_wait"}}},
     "then": {"properties": {"payload": {"required": ["seconds", "reason", "round"],
       "description": "Wizard waited for Gemini (both models refused). Not shown on the stage; counted in Error details."}}}},
    {"if": {"properties": {"type": {"const": "steer"}}},
     "then": {"properties": {"payload": {"required": ["steer"], "properties": {"steer": {"type": "object",
       "required": ["id", "text", "reason", "about", "at", "state"],
       "description": "A note the person sent while the run worked: their words, and the step it is about (Not this). Gemini reads it before its next step."}}}}}},
    {"if": {"properties": {"type": {"const": "steer_read"}}},
     "then": {"properties": {"payload": {"required": ["steer_id"],
       "description": "Gemini was handed the note: it joins the conversation before Gemini's next step."}}}},
    {"if": {"properties": {"type": {"const": "systems_changed"}}},
     "then": {"properties": {"payload": {"required": ["systems", "on", "off"],
       "description": "The person changed the systems picker while the run worked; systems is null for Auto."}}}},
    {"if": {"properties": {"type": {"const": "system_requested"}}},
     "then": {"properties": {"payload": {"required": ["system", "name", "reason"],
       "description": "Gemini asked for a system the person switched off (wizard_ask_for_system)."}}}},
    {"if": {"properties": {"type": {"const": "run_finished"}}},
     "then": {"properties": {"payload": {"required": ["status", "report_id", "answer", "data_mode", "check_status"]}}}},
    {"if": {"properties": {"type": {"const": "run_failed"}}},
     "then": {"properties": {"payload": {"required": ["code", "message"], "properties": {
       "details": {"type": "object", "additionalProperties": {"type": "string"},
                   "description": "Error details: why the run failed, label -> value (Google's finish reason and message, what Gemini sent back, the last tool call, where the run had got to). Tokens are redacted; never the prompt, the answer or private reasoning."}}}}}}
  ]
}
