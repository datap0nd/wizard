# Wizard configuration. Copy to .env (never commit .env). Environment variables override this file.

# --- Service --------------------------------------------------------------------------------------------------------
WIZARD_HOST=127.0.0.1
WIZARD_PORT=8770
# Where SQLite, per-user Gemini homes and OAuth secrets live (keep outside the repo in pilot installs).
WIZARD_DATA_DIR=var
# Required behind the corporate SSO proxy: the browser-facing origin, e.g. https://wizard.corp.example
# WIZARD_PUBLIC_ORIGIN=
# WIZARD_SECURE_COOKIES=true

# --- Agent runtime ----------------------------------------------------------------------------------------------------
# replay      recorded transcripts over SYNTHETIC data (CI, offline demos; labelled REPLAY everywhere)
# gemini-cli  Gemini CLI headless, one isolated GEMINI_CLI_HOME per user, Wizard tools over MCP (Step 02 route A)
# code-assist Code Assist API with each user's own Google sign-in, same tools in-process (Step 02 route B)
WIZARD_AGENT_RUNTIME=replay
WIZARD_GEMINI_MODEL=gemini-3.8-flash
WIZARD_GEMINI_THINKING=high
# Enterprise Gemini (Code Assist Standard/Enterprise) project; the same id Gemini CLI uses.
# GOOGLE_CLOUD_PROJECT=
# Path to the Gemini CLI bundle (gemini.js). Auto-detected from .tools/ or a global npm install when unset.
# WIZARD_GEMINI_CLI_JS=C:\Users\<you>\AppData\Roaming\npm\node_modules\@google\gemini-cli\bundle\gemini.js
# Testing only: offline model replies for the real CLI (never set in a pilot).
# WIZARD_GEMINI_FAKE_RESPONSES=fixtures/gemini_fake/ceo-two-tools.jsonl
# Optional: an enterprise-registered OAuth client instead of Gemini CLI's public installed-app client.
# WIZARD_GOOGLE_OAUTH_CLIENT_ID=
# WIZARD_GOOGLE_OAUTH_CLIENT_SECRET=
# Refuse to link a Google account whose email differs from the signed-in Wizard user (keep true).
WIZARD_REQUIRE_GOOGLE_EMAIL_MATCH=true
# Outbound proxy for Google (sign-in, Gemini API, and the Gemini CLI Wizard starts). Unset = resolve it: HTTPS_PROXY,
# then the `proxy` in your own Gemini CLI settings, then the Windows proxy settings (PAC included), then direct.
# Certificates are checked against the Windows certificate store (corporate TLS inspection works).
# WIZARD_PROXY=http://proxy.corp.example:8080
# WIZARD_PROXY=direct

# --- Content ---------------------------------------------------------------------------------------------------------
# Real platform guides and report catalogs (the internal wizard-content repo, see docs/documentation-guide.md).
# Unset = the built-in SYNTHETIC examples. Not allowed with the replay runtime.
# WIZARD_CONTENT_DIR=D:\wizard-content

# --- HTML reports -----------------------------------------------------------------------------------------------------
# Folder holding the standalone HTML reports (local files; subfolders allowed). Relative paths resolve against the
# install folder. Unset = no HTML reports. A path that is not a folder stops start-up with a clear message.
# WIZARD_HTML_REPORTS_DIR=C:\Reports\html

# --- Attached files ---------------------------------------------------------------------------------------------------
# Questions can carry PowerPoint, Excel, Word, email and CSV files, converted through Office (pywin32) on this PC.
# "From this PC" lists recent files in these folders (separated by ;) and reads them in place, which NASCA-protected
# files need. Default with fixture sign-in: your Downloads, Desktop and Documents; "none" switches it off. Behind an
# SSO proxy it stays off unless set (the server's folders are not the user's).
# WIZARD_ATTACHMENT_FOLDERS=C:\Users\<you>\Downloads;C:\Users\<you>\Documents
# WIZARD_MAX_ATTACHMENT_MB=50
# Seconds one conversion may take (a password prompt left open in Office would otherwise block it).
# WIZARD_ATTACHMENT_TIMEOUT_S=180
# auto = use Office when pywin32 can; never = read only plain .docx/.pptx/.xlsx without starting Office.
# WIZARD_ATTACHMENT_OFFICE=auto

# --- PostgreSQL (read-only) -------------------------------------------------------------------------------------------
# The documentation kit (.\docs.ps1 postgres-catalog, task 18) documents the materialized views from the server's
# catalog. Use a READ-ONLY account (for example Metronome's freshness-scanner account), never the uploader account.
# Unset = the PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD environment variables, if the scanner account set them.
# Sessions are read-only with short timeouts whatever the account. sslmode: disable, prefer, require, verify-ca,
# verify-full (verify-* check the certificate against the Windows store).
# WIZARD_PG_HOST=
# WIZARD_PG_PORT=5432
# WIZARD_PG_DATABASE=
# WIZARD_PG_USER=
# WIZARD_PG_PASSWORD=
# WIZARD_PG_SSLMODE=prefer
# The name people see for this database in the app and in answers' sources.
# WIZARD_PG_NAME=AI Team Database

# --- Knowledge base from a private GitHub repository (desktop app; docs/desktop.md) ------------------------------------
# Usually set by the company provisioning file (wizard.provision), not here. Wizard downloads the repository's content
# with a read-only token, validates it like WIZARD_CONTENT_DIR and keeps the last good version when offline.
# WIZARD_KB_REPO=acme/wizard-content
# WIZARD_KB_TOKEN=github_pat_...            fine-grained: that repository only, Contents read-only
# WIZARD_KB_REF=main
# WIZARD_KB_PATH=                           folder inside the repository, if the content is not at its root
# WIZARD_KB_SYNC_MINUTES=30                 0 = only at start-up
# Company Google domains allowed to link for Gemini (comma separated); empty = any account.
# WIZARD_GOOGLE_DOMAINS=company.com
# Publishing the knowledge base from the work PC (task 50, .\docs.ps1 kb-publish / kb-check). Only docs.ps1 reads these;
# they never go into a provisioning file.
# WIZARD_KB_PUBLISH_REPO=acme/wizard-content
# WIZARD_KB_PUBLISH_TOKEN=github_pat_...    Contents read and write, that repository only
# WIZARD_KB_READ_TOKEN=github_pat_...       the read-only token users get, for kb-check

# --- Portals Gemini may explore in Wizard's own browser (docs/decisions/2026-10-20-portal-browser.md) --------------------
# One line per portal: the page it opens on (https). The person signs in once in Sources → Portals → Sign in; Wizard's
# browser profile keeps the session on this PC. Read-only: nothing on a portal is saved, exported or sent.
# WIZARD_PORTAL_GSCM=https://gscm.company.com/
# WIZARD_PORTAL_ASAP=https://asap.company.com/MicroStrategyLibrary/
# WIZARD_PORTAL_BDP=https://bdp.company.com/
# WIZARD_PORTAL_BDP_NAME=Big Data Portal      what people see (default: the name in the key)
# WIZARD_PORTAL_GSCM_HOSTS=                   other hosts the portal's pages load from (comma separated, *.x allowed)
# WIZARD_PORTAL_SIGNIN_HOSTS=                 the company sign-in page, if a portal passes through one Wizard stops
# WIZARD_BROWSER=auto                         auto (Microsoft Edge on Windows), msedge, chrome, chromium, a path, or off
# WIZARD_BROWSER_VISIBLE=false                true shows the browser window during questions too (troubleshooting)

# --- Identity ---------------------------------------------------------------------------------------------------------
# fixture         SYNTHETIC test identities (development only)
# trusted-header  identity from the corporate SSO reverse proxy header, accepted only from WIZARD_TRUSTED_PROXIES
WIZARD_AUTH_MODE=fixture
# Work-PC installs: an Owner identity with your real email and rights to every platform, listed first in fixture mode.
# Its email must match the Google account you link. setup.ps1 fills it from `whoami /upn`.
# WIZARD_LOCAL_USER_EMAIL=
# WIZARD_LOCAL_USER_NAME=
# WIZARD_IDENTITY_HEADER=X-Forwarded-Email
# WIZARD_TRUSTED_PROXIES=127.0.0.1,::1

# --- Bounds -----------------------------------------------------------------------------------------------------------
# Backstops against a runaway run, not budgets for a normal answer. Gemini is told to wrap up and answer when it
# repeats an identical call, and in the last few minutes before WIZARD_RUN_TIMEOUT_S, so a long run still ends with an answer.
WIZARD_MAX_CONCURRENT_RUNS=8
WIZARD_RUN_TIMEOUT_S=1800
WIZARD_MAX_TOOL_CALLS=150
WIZARD_REPORT_RETENTION_DAYS=30
# Replay pacing so the demo streams visibly (seconds per chunk; 0 in CI).
WIZARD_REPLAY_DELAY_S=0.03
